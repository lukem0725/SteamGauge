# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real secrets.

# Supabase project URL (Project Settings -> API). Not a secret.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase SECRET key (starts with sb_secret_). Server only. Bypasses RLS.
SUPABASE_SECRET_KEY=

# Steam Web API key, 32 hex characters: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Public origin of this deployment. No path, no trailing slash.
# Local development: http://localhost:3000
APP_ORIGIN=http://localhost:3000

# 32 or more random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# 16 or more random characters. Vercel sends it to /api/cron/* as a bearer token.
CRON_SECRET=
